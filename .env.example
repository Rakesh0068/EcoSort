# EcoSort environment — copy to .env (backend) or set in the deploy dashboard.
# NEVER commit .env. Frontend values must use the VITE_ prefix to be public.

# --- Backend (FastAPI / uvicorn) ---
# Production frontend origin(s), comma-separated. Local dev defaults are
# built in. Use "*" only for local-network testing, never production.
# FRONTEND_ORIGINS=https://ecosort.vercel.app
# (legacy alias, same format)
# ALLOWED_ORIGINS=https://ecosort.vercel.app
# Upload cap in MB (serverless payload caps force this down, e.g. 4).
# MAX_UPLOAD_MB=12
# Dataset location (defaults to the development path in ml/config.py).
# ECOSORT_DATASET_ROOT=/data/archive
# Server port (uvicorn --port flag reads this in most hosts).
# PORT=8000

# --- Frontend (Vite build) ---
# Origin of the inference API when it lives apart from the frontend
# (e.g. frontend on Vercel, API on a GPU host). Leave empty for same-origin.
# VITE_API_URL=https://api.example.com
